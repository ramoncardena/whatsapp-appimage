{
  "name": "whatsdesk",
  "productName": "WhatsDesk",
  "version": "2.2.0",
  "description": "Unofficial desktop client for WhatsApp Web on Linux, with privacy features",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder && ./scripts/add-update-info.sh",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.ramoncardena.whatsdesk",
    "productName": "WhatsDesk",
    "linux": {
      "target": "AppImage",
      "category": "Network",
      "icon": "icon.png"
    }
  },
  "keywords": [
    "whatsapp",
    "linux",
    "electron",
    "appimage",
    "desktop",
    "privacy",
    "client",
    "messaging"
  ],
  "author": "Ramon Cardena <info@ramoncardena.com>",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  }
}
